    print(ZSH)


def build_parser():
    p = argparse.ArgumentParser(prog="labvm", description="Lima-VMs mit Hierarchie, Kurznamen und Plattenkompression (v%s)" % VERSION,
                                formatter_class=argparse.RawDescriptionHelpFormatter,
                                epilog="Beispiele:\n  labvm ls\n  labvm new 40c3/workshop/vm1 --cpus 4 --memory 8GiB\n  labvm start kubers        # Kurzname genügt\n  labvm mv fsre 40c3        # in anderen Ordner\n  labvm stop 26             # Ordner: alle darunter\n  labvm pack                # alle gestoppten VMs packen")
    p.add_argument("--version", action="version", version=VERSION)
    s = p.add_subparsers(dest="cmd")
    x = s.add_parser("ls", aliases=["list", "tree"], help="Baum mit Status, Zustand, Platzbedarf"); x.add_argument("path", nargs="?"); x.set_defaults(f=cmd_ls)
    x = s.add_parser("mkdir", help="Ordner anlegen"); x.add_argument("path"); x.set_defaults(f=cmd_mkdir)
    x = s.add_parser("mv", help="VM oder Ordner verschieben/umbenennen (Lima-Name bleibt)"); x.add_argument("src"); x.add_argument("dst"); x.set_defaults(f=cmd_mv)
    x = s.add_parser("adopt", help="vorhandene Lima-VM in den Baum aufnehmen"); x.add_argument("lima"); x.add_argument("path")
    x.add_argument("--no-autopack", action="store_true"); x.set_defaults(f=cmd_adopt)
    x = s.add_parser("new", help="neue Debian-13-VM anlegen")
    x.add_argument("path"); x.add_argument("--cpus", type=int, default=4); x.add_argument("--memory", default="4GiB"); x.add_argument("--disk", default="40GiB")
    x.add_argument("--compress", choices=["pack", "fs", "none"], default="pack",
                   help="pack: Platte nach dem Beenden mit zstd packen (Standard); fs: Root-Dateisystem btrfs mit zstd, komprimiert im Betrieb; none")
    x.add_argument("--mount", action="append", metavar="MAC:VM", help="Mac-Ordner einbinden (mehrfach)")
    x.add_argument("--lima", help="Lima-Name statt aus dem Pfad abgeleitet"); x.add_argument("--no-gui", action="store_true")
    x.add_argument("--note"); x.add_argument("--start", action="store_true", help="nach dem Anlegen laufen lassen")
    x.add_argument("--no-provision", action="store_true", help="nur anlegen, keine Standard-Ausstattung installieren")
    x.add_argument("--no-share", action="store_true", help="keinen Mount ~/LabShare/<Pfad> -> /mnt/share"); x.set_defaults(f=cmd_new)
    x = s.add_parser("image", help="btrfs-Basisimage bauen (für new --compress fs)"); x.add_argument("--force", action="store_true"); x.set_defaults(f=cmd_image)
    x = s.add_parser("provision", help="Standard-Ausstattung (Chromium, Compiler, Unix-Tools, Claude Code, Qwen Code) installieren/aktualisieren")
    x.add_argument("name"); x.add_argument("--no-gui", action="store_true"); x.add_argument("--ai-only", action="store_true", help="nur KI-Werkzeuge und Browser-Vorgabe")
    x.set_defaults(f=cmd_provision)
    x = s.add_parser("start", help="auspacken und starten (Wächter packt nach dem Beenden)"); x.add_argument("name")
    x.add_argument("--wait", action="store_true", help="im Vordergrund bleiben, bis die VM beendet ist"); x.set_defaults(f=cmd_start)
    x = s.add_parser("run", help="wie start --wait (für Start-Apps)"); x.add_argument("name"); x.set_defaults(f=cmd_run)
    x = s.add_parser("stop", help="stoppen (Ordner: alle darunter) und ggf. packen"); x.add_argument("names", nargs="+")
    x.add_argument("--force", action="store_true", help="hart beenden (limactl stop --force)"); x.set_defaults(f=cmd_stop)
    x = s.add_parser("shell", help="Shell in der VM (startet sie bei Bedarf)"); x.add_argument("name"); x.add_argument("cmd", nargs=argparse.REMAINDER); x.set_defaults(f=cmd_shell)
    x = s.add_parser("pack", help="gestoppte VMs packen (ohne Namen: alle gestoppten)"); x.add_argument("names", nargs="*")
    x.add_argument("--level", type=int, default=3); x.set_defaults(f=cmd_pack)
    x = s.add_parser("unpack", help="auspacken (ohne Namen: alle)"); x.add_argument("names", nargs="*"); x.set_defaults(f=cmd_unpack)
    x = s.add_parser("autopack", help="Auto-Pack einer VM ein-/ausschalten"); x.add_argument("name"); x.add_argument("mode", choices=["on", "off"]); x.set_defaults(f=cmd_autopack)
    x = s.add_parser("info", help="Details einer VM"); x.add_argument("name"); x.set_defaults(f=cmd_info)
    x = s.add_parser("rm", help="VM (mit --yes) oder leeren Ordner löschen"); x.add_argument("name"); x.add_argument("--yes", action="store_true"); x.set_defaults(f=cmd_rm)
    x = s.add_parser("doctor", help="Voraussetzungen und Baum prüfen"); x.set_defaults(f=cmd_doctor)
    x = s.add_parser("completion", help="zsh-Vervollständigung: source <(labvm completion zsh)"); x.add_argument("shell", nargs="?", default="zsh"); x.set_defaults(f=cmd_completion)
    x = s.add_parser("_watch"); x.add_argument("lima"); x.set_defaults(f=cmd_watch)
    x = s.add_parser("_paths"); x.set_defaults(f=cmd_paths)
    return p


def main(argv=None):
    p = build_parser()
    a = p.parse_args(argv)
    if not getattr(a, "f", None):
        a = p.parse_args(["ls"])
    a.f(a)


if __name__ == "__main__":
    main()
