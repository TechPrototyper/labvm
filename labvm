#!/usr/bin/env python3
"""labvm - VM-Verwaltung für Lima auf dem Mac: Hierarchie (Ordner/Unterordner), Kurznamen, Platten packen (zstd).

Lima kennt nur flache Namen. labvm führt daneben einen Baum (~/.config/labvm/tree.json), z. B.
    labortage26/z80, labortage26/kubers, 40c3/workshop/vm1
und löst Kurznamen auf: `labvm start kubers` genügt, solange er eindeutig ist (auch "kub", "26/kub", Lima-Name).
Nur Python-Standardbibliothek; benötigt limactl, für Pack/Unpack zstd (brew install zstd).
Befehle: siehe `labvm --help`.
"""
import argparse
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import time

VERSION = "1.0"
HOME = os.path.expanduser("~")
CONFIG = os.environ.get("LABVM_CONFIG", os.path.join(HOME, ".config", "labvm", "tree.json"))
LIMA_HOME = os.environ.get("LIMA_HOME", os.path.join(HOME, ".lima"))
LOG = os.path.join(HOME, "Library", "Logs", "labvm.log")
SHARE = os.environ.get("LABVM_SHARE", os.path.join(HOME, "LabShare"))   # Mac-Ordner: bildet den VM-Baum ab
PROFILE = os.path.join(os.path.dirname(os.path.realpath(__file__)), "profile")
CACHE = os.path.join(HOME, ".cache", "lab")
for _p in ("/opt/homebrew/bin", "/usr/local/bin"):
    if _p not in os.environ.get("PATH", "").split(":"):
        os.environ["PATH"] = _p + ":" + os.environ.get("PATH", "")

